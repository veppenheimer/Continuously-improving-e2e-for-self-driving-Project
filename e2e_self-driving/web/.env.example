# Backend API base URL used by the browser.
# In development, keep /api so Vite proxies requests to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Backend HTTP service used by the Vite /api proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: enable WebSocket live progress instead of HTTP polling.
# Leave empty unless the backend is reachable directly from the browser.
# VITE_WS_BASE_URL=ws://127.0.0.1:8000
